# Token do bot do Telegram (BotFather). O bot precisa estar no canal de origem.
TELEGRAM_BOT_TOKEN=

# JID do canal de destino no WhatsApp (termina em @newsletter).
# Não sabe o JID? Rode: npm run resolve-channel https://whatsapp.com/channel/XXXX
WHATSAPP_CHANNEL_JID=

# Texto final. {texto} é substituído pela mensagem do Telegram.
MESSAGE_TEMPLATE=📢 Promoção nova\n\n{texto}\n\n#promocao #oferta

# Pastas de estado (não versione)
AUTH_DIR=./auth
DATA_DIR=./data
