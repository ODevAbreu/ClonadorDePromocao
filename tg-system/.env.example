# Credenciais da API do Telegram — https://my.telegram.org (API development tools)
API_ID=
API_HASH=

# Banco (SQLite por padrão). Para Postgres: postgresql+psycopg://user:senha@host/db
DATABASE_URL=sqlite:///data/tg-system.db

# Proxy opcional (recomendado: mesmo IP/região das contas). Ex.: socks5://user:pass@host:1080
PROXY_URL=

# Senha simples do painel (opcional; só use o painel em rede confiável/atrás de VPN)
PANEL_PASSWORD=
